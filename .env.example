# Database - PostgreSQL (Supabase, Railway, ou Render)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# NextAuth - Authentication
# Générer avec: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-prod"

# Google OAuth - https://console.cloud.google.com
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Dexpay - Payment API
# Test: pk_test_xxx / sk_test_xxx
# Production: pk_live_xxx / sk_live_xxx
DEXPAY_PUBLIC_KEY=""
DEXPAY_SECRET_KEY=""
DEXPAY_BASE_URL="https://api.dexpay.africa"

# Email - Nodemailer (optionnel pour les tests)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@yourstore.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MonShop"

# Security
SEED_TOKEN="your-seed-token-change-in-production"
